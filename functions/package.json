{
  "name": "hampa-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Firebase backend of HamPA (هم‌پا)",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": ">=6.0.0",
    "@google/genai": "^0.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "private": true
}
